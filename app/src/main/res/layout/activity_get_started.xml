<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/gradient_get_started_bg"
    android:gravity="center"
    android:padding="32dp">

    <!-- App Logo/Icon -->
    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/icon"
        android:layout_marginBottom="32dp"
        android:scaleType="fitCenter" />

    <!-- Welcome Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome to Bridge"
        android:textSize="32sp"
        android:textStyle="bold"
        android:textColor="@color/primary"
        android:gravity="center"
        android:shadowColor="@color/shadow_neon"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="12"
        android:layout_marginBottom="16dp" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Your AI-powered communication companion"
        android:textSize="18sp"
        android:textColor="@color/on_surface_variant"
        android:gravity="center"
        android:alpha="0.9"
        android:layout_marginBottom="64dp" />

    <!-- Get Started Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGetStarted"
        android:layout_width="match_parent"
        android:layout_height="64dp"
        android:text="Get Started"
        android:textColor="@color/on_primary"
        android:textSize="18sp"
        android:textStyle="bold"
        app:cornerRadius="20dp"
        app:backgroundTint="@color/primary"
        app:rippleColor="@color/ripple_neon"
        android:shadowColor="@color/shadow_neon"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="16"
        android:elevation="8dp" />

    <!-- Decorative glow effect -->
    <View
        android:layout_width="200dp"
        android:layout_height="200dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/circle_glow_bg"
        android:alpha="0.1" />

</LinearLayout>